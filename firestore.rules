rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is viewing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Check if user is blocked by another user
    function isBlocked(blockerId, blockedId) {
      let blockerDoc = get(/databases/$(database)/documents/users/$(blockerId));
      return blockerDoc.data.blockedUsers != null && 
             blockerDoc.data.blockedUsers.hasAny([blockedId]);
    }
    
    // Check if users can interact (not blocked)
    function canInteract(user1Id, user2Id) {
      return !isBlocked(user1Id, user2Id) && !isBlocked(user2Id, user1Id);
    }
    
    // Validate event data for creation/updates
    function isValidEvent() {
      let incomingData = request.resource.data;
      return incomingData.name is string &&
             incomingData.name.size() > 0 &&
             incomingData.name.size() < 100 &&
             incomingData.host is string &&
             incomingData.date is timestamp;
    }
    
    // User profiles - users can read any profile but only edit their own
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
      
      // Allow updates to specific fields by other users (e.g., followers)
      match /{allChildren=**} {
        allow read: if isAuthenticated();
      }
      
      // Chat last opened tracking - users can update their own chat timestamps
      match /chatLastOpened/{eventId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Events - users can read all events but only edit their own
    match /events/{eventId} {
      // Anyone can read events
      // NOTE: Do not store plaintext passwords on event docs long-term;
      // private/paid seating must go through Cloud Functions (Admin SDK).
      allow read: if true;
      
      // Only event owner can create/delete events
      allow create: if isAuthenticated() && isValidEvent() && request.resource.data.host == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      (resource.data.host == request.auth.uid || isAdmin());
      
      // Host-only operations: performer management, event settings
      allow update: if isAuthenticated() && 
                      resource.data.host == request.auth.uid &&
                      // Host can update any field
                      true;
      
      // Admin override for any operation                
      allow update: if isAuthenticated() && isAdmin();
                      
      // Attendee self join/leave for PUBLIC free events only.
      // Private and paid events must use authenticated Cloud Functions.
      allow update: if isAuthenticated() && 
                      resource.data.isPrivate != true &&
                      (!(('price' in resource.data) && resource.data.price > 0)) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'waitlist']) &&
                      (
                        // User joining event (adding themselves to attendees)
                        (request.resource.data.attendees.hasAll(resource.data.attendees.concat([request.auth.uid])) &&
                         request.resource.data.attendees.size() == resource.data.attendees.size() + 1) ||
                        // User leaving event (removing themselves from attendees)
                        (resource.data.attendees.hasAll(request.resource.data.attendees.concat([request.auth.uid])) &&
                         resource.data.attendees.size() == request.resource.data.attendees.size() + 1) ||
                        // Waitlist operations for current user only
                        (request.resource.data.waitlist.hasAll(resource.data.waitlist.concat([request.auth.uid])) &&
                         request.resource.data.waitlist.size() == resource.data.waitlist.size() + 1) ||
                        (resource.data.waitlist.hasAll(request.resource.data.waitlist.concat([request.auth.uid])) &&
                         resource.data.waitlist.size() == request.resource.data.waitlist.size() + 1)
                      ) &&
                            // Prevent blocked users from joining events
      canInteract(resource.data.host, request.auth.uid);
      
      // Event chat messages - subcollection of events
      match /messages/{messageId} {
        // Anyone can read messages for events they can access
        allow read: if isAuthenticated();
        
        // Only authenticated users can create messages
        allow create: if isAuthenticated() && 
                        request.resource.data.senderId == request.auth.uid &&
                        request.resource.data.text is string &&
                        request.resource.data.text.size() > 0 &&
                        request.resource.data.text.size() <= 500;
        
        // Only message sender can update/delete their own messages
        allow update, delete: if isAuthenticated() && 
                                resource.data.senderId == request.auth.uid;
      }
    }
    
    // Public event images
    match /event_images/{imageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Admin-only collections
    // Users may read their own admin doc (for client UI gating).
    // Writes remain admin-only / Admin SDK bootstrap.
    match /admins/{docId} {
      allow read: if isAuthenticated() && (isOwner(docId) || isAdmin());
      allow write: if isAdmin();
    }

    // Explicit deny/owner rules for sensitive collections used by Functions / payouts
    match /reports/{reportId} {
      allow read, write: if false; // Functions Admin SDK only
    }
    match /stripe_usage/{docId} {
      allow read, write: if false; // Functions Admin SDK only
    }
    match /paymentMethods/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /bankVerifications/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /payouts/{docId} {
      allow read: if isAuthenticated() && resource.data.hostId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if false; // status changes via trusted backend only
    }
    
    // System configurations
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
} 